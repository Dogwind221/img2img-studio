# 复制本文件为 .env 并填入凭据（不要提交 .env）
# 不配置也行：脚本会自动回退读取 dsh-vision-skill/scripts/.env 里的 VISION_API_KEY 走 DashScope（qwen-image-3.0-pro）。

# --- 方式 1：DashScope 通义千问/万相（国内直连，推荐；可只填 DASHSCOPE_API_KEY） ---
DASHSCOPE_API_KEY=sk-你的key
# IMG_MODEL=qwen-image-3.0-pro        # 可选覆盖（t2i/i2i 默认链均为 qwen-image-3.0-pro → 自动降级）

# --- 方式 2：OpenAI 兼容 API（第三方中转 / gpt-image） ---
# IMG_BASE_URL=https://api.openai.com/v1
# IMG_MODEL=gpt-image-2
# IMG_API_KEY=sk-你的key
# IMG_IMAGE_API_DIALECT=openai-native  # 或 ratio-metadata（Gemini 类中转网关）

# --- 方式 3：Z.AI GLM-Image（智谱，中英文文字/海报渲染强，不支持参考图） ---
# ZAI_API_KEY=你的key
# ZAI_IMAGE_MODEL=glm-image

# --- 方式 4：Seedream 豆包（火山方舟，OpenAI 兼容，4.0+ 支持参考图） ---
# ARK_API_KEY=你的key
# SEEDREAM_IMAGE_MODEL=doubao-seedream-5-0-260128

# --- 方式 5：MiniMax 海螺（image-01，人物一致性 subject_reference） ---
# MINIMAX_API_KEY=你的key

# --- 方式 6：本地生图服务（chatgpt-web 类代理，如 gpt-image2-ecommerce 的 4312 服务） ---
# IMG_HTTP_URL=http://127.0.0.1:4312

# 供应商优先级（auto）：openai -> dashscope -> zai -> seedream -> minimax -> local
# 模型策略：性能优先 + 发布时间最近优先（qwen-image-3.0-pro / qwen3.8-max 为当前旗舰）
